  "customer_tier": {
    "applies_to": "customer role, at prospect and customer stage",
    "method": "Points per stable company attribute, added into a score; thresholds turn the score into a tier. Same points as LeadFlow's fit score (LF-RULES-v1.0 fit_scoring) for the two attributes master data holds",
    "industry_points": {
      "market_research": 40,
      "polling": 40,
      "research_consultancy": 40,
      "panel_sample_provider": 40,
      "research_technology": 30,
      "advertising_media_pr_agency": 30,
      "ux_research_agency": 30,
      "management_consultancy": 30,
      "consumer_goods": 20,
      "retail_ecommerce": 20,
      "technology_telecoms": 20,
      "financial_services": 20,
      "automotive_mobility": 20,
      "healthcare_pharma": 20,
      "travel_hospitality": 20,
      "media_entertainment_gaming": 20,
      "energy_utilities": 20,
      "public_academic_nonprofit": 20,
      "other": 0,
      "unknown": null
    },
    "employee_band_points": {
      "1-10": 0,
      "11-49": 5,
      "50-249": 10,
      "250-999": 15,
      "1000_plus": 20,
      "unknown": null
    },
    "score_range": [
      0,
      60
    ],
    "thresholds": {
      "tier_1": 50,
      "tier_2": 30
    },
    "tiers": {
      "tier_1": "Strategic",
      "tier_2": "Core",
      "tier_3": "Standard",
      "unknown": "Industry or employee band unknown"
    },
    "tier_order": [
      "tier_1",
      "tier_2",
      "tier_3"
    ],
    "unknown_if_any_input_unknown": true,
    "group_rollup": {
      "rule": "Group tier = the highest calculated tier among all current members of the partner's group (its top parent and every descendant). Unknown tiers are ignored; if all are unknown, the group tier is unknown. A partner with no group has a group tier equal to its calculated tier"
    },
    "override": {
      "request_type": "override_customer_tier",
      "approver": "sales_director",
      "calculated_and_group_tier_kept": true
    },
    "effective_tier": "override if present, otherwise group tier",
    "recalculated_when": [
      "industry_code changes",
      "employee_band changes",
      "hierarchy changes",
      "a new rules version is loaded"
    ],
    "reason_codes": {
      "TIER_INDUSTRY_CORE": "Core research industry (40 points)",
      "TIER_INDUSTRY_ADJACENT": "Research-adjacent industry (30 points)",
      "TIER_INDUSTRY_OTHER_NAMED": "Other named industry (20 points)",
      "TIER_INDUSTRY_OTHER": "Industry 'other' (0 points)",
      "TIER_SIZE_1_10": "1-10 employees (0 points)",
      "TIER_SIZE_11_49": "11-49 employees (5 points)",
      "TIER_SIZE_50_249": "50-249 employees (10 points)",
      "TIER_SIZE_250_999": "250-999 employees (15 points)",
      "TIER_SIZE_1000_PLUS": "1000+ employees (20 points)",
      "TIER_UNKNOWN_INDUSTRY": "Industry unknown: tier unknown",
      "TIER_UNKNOWN_SIZE": "Employee band unknown: tier unknown",
      "TIER_GROUP_ROLLUP": "Group tier is higher than the partner's own tier",
      "TIER_OVERRIDE": "Effective tier set by an approved override"
    }
  },
  "quality_rules": [
    {
      "id": "C01",
      "dimension": "completeness",
      "severity": "error",
      "rule": "Every field mandatory for the record's stage is filled"
    },
    {
      "id": "C02",
      "dimension": "completeness",
      "severity": "warning",
      "rule": "A customer's industry and employee band are not 'unknown'"
    },
    {
      "id": "C03",
      "dimension": "completeness",
      "severity": "warning",
      "rule": "A customer or approved supplier has at least one contact person with a role"
    },
    {
      "id": "V01",
      "dimension": "validity",
      "severity": "error",
      "rule": "Tax ID has the right format and check digit for its country"
    },
    {
      "id": "V02",
      "dimension": "validity",
      "severity": "error",
      "rule": "VAT number agrees with the tax ID and country"
    },
    {
      "id": "V03",
      "dimension": "validity",
      "severity": "error",
      "rule": "Country is a valid ISO code"
    },
    {
      "id": "V04",
      "dimension": "validity",
      "severity": "error",
      "rule": "Postal code fits the country's pattern"
    },
    {
      "id": "V05",
      "dimension": "validity",
      "severity": "error",
      "rule": "Web domain is clean and is not a free email domain"
    },
    {
      "id": "V06",
      "dimension": "validity",
      "severity": "error",
      "rule": "Email addresses have a valid format"
    },
    {
      "id": "V07",
      "dimension": "validity",
      "severity": "warning",
      "rule": "Phone is in international format"
    },
    {
      "id": "V08",
      "dimension": "validity",
      "severity": "error",
      "rule": "Payment terms are in the allowed list"
    },
    {
      "id": "V09",
      "dimension": "validity",
      "severity": "error",
      "rule": "IBAN has the right length and check digits"
    },
    {
      "id": "V10",
      "dimension": "validity",
      "severity": "warning",
      "rule": "Legal form is in the country's list and agrees with the ending of the legal name"
    },
    {
      "id": "V11",
      "dimension": "validity",
      "severity": "error",
      "rule": "Legal name is not a placeholder"
    },
    {
      "id": "V12",
      "dimension": "validity",
      "severity": "error",
      "rule": "An approved supplier has a physical registered address, not only a PO box"
    },
    {
      "id": "V13",
      "dimension": "validity",
      "severity": "error",
      "rule": "An intra-EU partner (registered outside Spain) at customer or approved-supplier stage has VIES status valid, checked within the last 12 months and after its last tax ID change"
    },
    {
      "id": "U01",
      "dimension": "uniqueness",
      "severity": "error",
      "rule": "A tax ID belongs to only one active partner"
    },
    {
      "id": "U02",
      "dimension": "uniqueness",
      "severity": "error",
      "rule": "Every source record is linked to exactly one partner"
    },
    {
      "id": "U03",
      "dimension": "uniqueness",
      "severity": "warning",
      "rule": "An IBAN belongs to only one supplier, unless the suppliers are in the same group or the IBAN is a documented factoring company or alternative payee; sent to review"
    },
    {
      "id": "U04",
      "dimension": "uniqueness",
      "severity": "error",
      "rule": "A source record does not bring back a contact on the suppression list (erased or opted out); the contact is not loaded and the DPO is told"
    },
    {
      "id": "K01",
      "dimension": "consistency",
      "severity": "error",
      "rule": "The tax ID's country is the country of registration"
    },
    {
      "id": "K02",
      "dimension": "consistency",
      "severity": "warning",
      "rule": "Bank account holder name compared with the legal name: match passes; close match (similarity 0.85 or more) is a warning for review; no match fails unless a factoring company or alternative payee is documented"
    },
    {
      "id": "K03",
      "dimension": "consistency",
      "severity": "warning",
      "rule": "The IBAN's country is the country of registration, or an exception is recorded"
    },
    {
      "id": "K04",
      "dimension": "consistency",
      "severity": "error",
      "rule": "The bill-to party exists, is active and is not blocked"
    },
    {
      "id": "K05",
      "dimension": "consistency",
      "severity": "error",
      "rule": "The parent exists and is not blocked; no loop; at most five levels"
    },
    {
      "id": "K06",
      "dimension": "consistency",
      "severity": "warning",
      "rule": "Each governed field has the same value in every source system as in the golden record"
    },
    {
      "id": "K07",
      "dimension": "consistency",
      "severity": "error",
      "rule": "A blocked partner has a reason and an approver; an unblocked partner has neither"
    },
    {
      "id": "K08",
      "dimension": "consistency",
      "severity": "warning",
      "rule": "A contact person's email domain is the partner's web domain"
    },
    {
      "id": "K09",
      "dimension": "consistency",
      "severity": "warning",
      "rule": "A source record carries a tax ID that belongs to another partner (for example a subsidiary holding its mother company's tax ID); reported back to the source system's owner"
    },
    {
      "id": "K10",
      "dimension": "consistency",
      "severity": "error",
      "rule": "A supplier's IBAN, address or phone does not match an employee in the HR extract, unless the Finance Controller has cleared it; matches go to the Finance Controller"
    },
    {
      "id": "K11",
      "dimension": "consistency",
      "severity": "error",
      "rule": "A partner with an active role is not shown as ceased, in insolvency proceedings or absorbed in the latest registry extract, unless it already has the matching block; a hit becomes a steward task within one working day"
    },
    {
      "id": "K12",
      "dimension": "consistency",
      "severity": "error",
      "rule": "A bank-details change is verified through a contact who is active and was verified within the last 12 months, and never through the message that asked for the change"
    },
    {
      "id": "K13",
      "dimension": "consistency",
      "severity": "warning",
      "rule": "Bank details are not changed back to a previous IBAN within 90 days, nor changed twice within 30 days; a hit goes to the Finance Controller"
    },
    {
      "id": "T01",
      "dimension": "timeliness",
      "severity": "warning",
      "rule": "A customer or approved supplier was reviewed in the last 12 months"
    },
    {
      "id": "T02",
      "dimension": "timeliness",
      "severity": "warning",
      "rule": "Supplier bank details were verified after their last change and within the last 24 months"
    },
    {
      "id": "T03",
      "dimension": "timeliness",
      "severity": "warning",
      "rule": "A change in a source system reaches the hub within one working day"
    },
    {
      "id": "T04",
      "dimension": "timeliness",
      "severity": "warning",
      "rule": "A match suggestion is decided within five working days"
    },
    {
      "id": "T05",
      "dimension": "timeliness",
      "severity": "warning",
      "rule": "An approved supplier with no ERP activity for 12 months is flagged for deactivation; reactivation needs a reactivate_supplier request"
    },
    {
      "id": "T06",
      "dimension": "timeliness",
      "severity": "warning",
      "rule": "A contact of a prospect with no contact for 3 years is anonymised (CNIL guideline)"
    }
  ],
  "quality_parameters": {
    "T01_review_months": 12,
    "T02_bank_verification_months": 24,
    "T03_max_working_days": 1,
    "T04_max_working_days": 5,
    "K05_max_hierarchy_levels": 5,
    "K12_contact_verified_months": 12,
    "K13_change_back_days": 90,
    "K13_double_change_days": 30,
    "T05_dormant_months": 12,
    "T06_prospect_retention_years": 3,
    "V13_vies_recheck_months": 12,
    "K02_close_match_similarity": 0.85
  },
  "clean_up_phase": {
    "auto_correct": false,
    "auto_delete": false,
    "failures_become": "steward work items"
  },
  "matching": {
    "name_standardisation": [
      "upper case",
      "remove accents",
      "remove punctuation",
      "remove legal forms SL, SLU, SA, SAU, SCOOP, LDA, UNIPESSOAL, SAS, SASU, SARL, EURL",
      "collapse spaces"
    ],
    "similarity": "difflib.SequenceMatcher(None, a, b).ratio() on the standardised names, rounded to 3 decimals (G1)",
    "order": "M1 to M5: the first rule that applies decides. M6 runs on every pair independently (G2)",
    "auto_link_rules": [
      "M1"
    ],
    "rules": [
      {
        "id": "M1",
        "evidence": "Same valid tax ID and standardised names at least 0.90 similar",
        "outcome": "same_partner",
        "auto_link": true,
        "min_name_similarity": 0.9
      },
      {
        "id": "M1B",
        "evidence": "Same valid tax ID but standardised names less than 0.90 similar",
        "outcome": "suggestion",
        "strength": "tax_conflict",
        "priority": "high",
        "auto_link": false,
        "steward_outcomes": {
          "confirmed": "Same legal entity (an office or trading name): one partner; the differing name or address is kept as a trading name or branch address",
          "rejected": "Different companies (for example a subsidiary carrying its mother company's tax ID): kept apart; the record's tax ID is flagged by K09 and reported to the source owner"
        }
      },
      {
        "id": "M2",
        "evidence": "Different valid tax IDs",
        "outcome": "never_same_partner",
        "auto_link": false,
        "group_suggestion_if": "same web domain or name similarity >= 0.85"
      },
      {
        "id": "M3",
        "evidence": "At least one side has no valid tax ID; same web domain; same country; name similarity 0.92 or more, or one standardised name starts with the other as whole words (G3)",
        "outcome": "suggestion",
        "strength": "strong",
        "auto_link": false,
        "min_name_similarity": 0.92,
        "prefix_match": true
      },
      {
        "id": "M4",
        "evidence": "Name similarity >= 0.85 and same postal code or phone",
        "outcome": "suggestion",
        "strength": "normal",
        "auto_link": false,
        "min_name_similarity": 0.85
      },
      {
        "id": "M5",
        "evidence": "Name similarity 0.75 or more and the same city (G5)",
        "outcome": "suggestion",
        "strength": "weak",
        "auto_link": false,
        "min_name_similarity": 0.75
      },
      {
        "id": "M6",
        "evidence": "Same IBAN on two different partners, checked on every pair (G2); a documented factoring company or alternative payee is not flagged",
        "outcome": "bank_risk_review",
        "priority": "high",
        "auto_link": false,
        "independent": true
      }
    ],
    "supporting_only": [
      "shared contact email"
    ],
    "suggestion_outcomes": [
      "confirmed",
      "rejected",
      "group"
    ],
    "rejected_pair_resuggested_only_if_record_changes": true,
    "stored_with_each_suggestion": [
      "rule_id",
      "score",
      "compared_values",
      "rules_version"
    ],
    "test_metrics": [
      "precision",
      "recall"
    ],
    "names_compared": "Current legal and trading names and former names; the highest similarity counts",
    "invalid_tax_ids": "A tax ID that fails V01 is treated as missing (G4)"
  },
  "survivorship": [
    "A value set through an approved request wins until a later approved request changes it",
    "Otherwise the valid value from the winning source for the field group",
    "If that source has no valid value, the most recently changed valid value from another source (not for bank details, G8)",
    "An empty value never replaces a filled one; an invalid value never replaces a valid one"
  ],
  "survivorship_lineage": [
    "source_record_id",
    "survivorship_step"
  ],
