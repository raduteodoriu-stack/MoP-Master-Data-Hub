      "bounced",
      "erased"
    ],
    "vies_status": [
      "valid",
      "not_registered",
      "invalid"
    ],
    "payee_type": [
      "own_account",
      "factoring_company",
      "alternative_payee"
    ],
    "holder_match": [
      "match",
      "close_match",
      "no_match"
    ],
    "registry_status": [
      "active",
      "ceased",
      "insolvency_proceedings",
      "absorbed"
    ],
    "corporate_event_type": [
      "rename",
      "legal_form_change",
      "merger_absorption"
    ],
    "po_box_markers": [
      "APARTADO",
      "APDO",
      "APARTADO DE CORREOS",
      "PO BOX",
      "P O BOX",
      "BOITE POSTALE",
      "BP",
      "CS",
      "CEDEX",
      "CAIXA POSTAL",
      "APARTADO POSTAL"
    ]
  },
  "sources": {
    "crm": "HubSpot CRM (LeadFlow companies)",
    "erp": "Finance/ERP: customer and supplier accounts",
    "support": "Support desk",
    "procurement_sheet": "Procurement spreadsheet of suppliers",
    "registry": "Simulated public registry extract (company status by tax ID: SIRENE-, BOE/Registro Publico Concursal- and Citius-style); reference data, not linked to partners",
    "hr": "Synthetic HR extract (employee IBAN, address, phone) used only for the employee-supplier cross-match; restricted"
  },
  "field_groups": {
    "legal_identity": {
      "fields": [
        "legal_name",
        "legal_form",
        "country",
        "tax_id",
        "vat_number",
        "vies_status"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "addresses": {
      "fields": [
        "registered_address",
        "billing_address"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "customer_payment": {
      "fields": [
        "payment_terms_customer",
        "bill_to_partner",
        "invoice_email",
        "billing_block"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "customer_commercial": {
      "fields": [
        "trading_name",
        "web_domain",
        "industry_code",
        "employee_band",
        "customer_tier_override",
        "account_owner"
      ],
      "owner": "sales_director",
      "winning_source": "crm"
    },
    "supplier_payment": {
      "fields": [
        "bank_details",
        "payment_terms_supplier",
        "remittance_email",
        "payment_block",
        "payee_type"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "supplier_commercial": {
      "fields": [
        "supplier_category",
        "internal_contact"
      ],
      "owner": "head_of_operations",
      "winning_source": "procurement_sheet",
      "winning_source_after_migration": "hub"
    },
    "relationships": {
      "fields": [
        "parent_partner"
      ],
      "owner": "sales_director",
      "winning_source": "hub"
    },
    "lifecycle": {
      "fields": [
        "customer_stage",
        "supplier_stage",
        "block"
      ],
      "owner": {
        "customer": "sales_director",
        "supplier": "head_of_operations",
        "block": "finance_controller"
      },
      "winning_source": "hub"
    },
    "contact_persons": {
      "fields": [
        "first_name",
        "last_name",
        "work_email",
        "role",
        "legal_basis"
      ],
      "owner": {
        "customer": "sales_director",
        "supplier": "head_of_operations"
      },
      "consulted": "dpo",
      "winning_source": "crm"
    }
  },
  "fields": {
    "legal_name": {
      "part": "general",
      "risk": "high",
      "standard": "As on the tax registration, legal form in the country's standard spelling; no placeholders"
    },
    "trading_name": {
      "part": "general",
      "risk": "low",
      "standard": "Name the company is known by; used for prospects before the legal name is known"
    },
    "legal_form": {
      "part": "general",
      "risk": "high",
      "standard": "From countries.<cc>.legal_forms"
    },
    "country": {
      "part": "general",
      "risk": "high",
      "standard": "ISO 3166-1 alpha-2"
    },
    "tax_id": {
      "part": "general",
      "risk": "high",
      "standard": "Country format and check digit; stored without spaces, dots or dashes"
    },
    "vat_number": {
      "part": "general",
      "risk": "high",
      "standard": "Derived from tax_id and country; never typed by hand"
    },
    "web_domain": {
      "part": "general",
      "risk": "low",
      "standard": "Lower case, registrable domain only (no www, scheme or path); not a free email domain"
    },
    "registered_address": {
      "part": "general",
      "risk": "high",
      "standard": "Street, postal code, city, region, country as separate fields"
    },
    "phone": {
      "part": "general",
      "risk": "low",
      "standard": "International format: + and digits only"
    },
    "account_owner": {
      "part": "customer",
      "risk": "low",
      "standard": "An existing, active LeadFlow owner ID"
    },
    "industry_code": {
      "part": "customer",
      "risk": "low",
      "standard": "controlled_values.industry_code"
    },
    "employee_band": {
      "part": "customer",
      "risk": "low",
      "standard": "controlled_values.employee_band"
    },
    "billing_address": {
      "part": "customer",
      "risk": "high",
      "standard": "Same structure as registered_address"
    },
    "bill_to_partner": {
      "part": "customer",
      "risk": "high",
      "standard": "An existing, active, unblocked partner"
    },
    "payment_terms_customer": {
      "part": "customer",
      "risk": "high",
      "standard": "controlled_values.payment_terms; anything else needs the Finance Controller"
    },
    "invoice_email": {
      "part": "customer",
      "risk": "high",
      "standard": "Valid format; shared mailbox preferred"
    },
    "billing_block": {
      "part": "customer",
      "risk": "high",
      "standard": "Reason and approver when set"
    },
    "supplier_category": {
      "part": "supplier",
      "risk": "low",
      "standard": "controlled_values.supplier_category"
    },
    "internal_contact": {
      "part": "supplier",
      "risk": "low",
      "standard": "MoP Cloud employee responsible for the supplier"
    },
    "payment_terms_supplier": {
      "part": "supplier",
      "risk": "high",
      "standard": "controlled_values.payment_terms"
    },
    "remittance_email": {
      "part": "supplier",
      "risk": "high",
      "standard": "Valid format; shared mailbox preferred"
    },
    "bank_details": {
      "part": "supplier",
      "risk": "high",
      "standard": "IBAN with valid length and check digits, account holder name, last verification date, method and verifier"
    },
    "payment_block": {
      "part": "supplier",
      "risk": "high",
      "standard": "Reason and approver when set"
    },
    "contact_person": {
      "part": "contact",
      "risk": "personal_data",
      "standard": "First name, last name, work email, role, legal basis; no private email, no other personal data"
    },
    "parent_partner": {
      "part": "relationship",
      "risk": "high",
      "standard": "Existing, unblocked partner; no loops; at most five levels"
    },
    "customer_tier_override": {
      "part": "customer",
      "risk": "low",
      "standard": "tier_1, tier_2 or tier_3; set only through an approved override_customer_tier request"
    },
    "former_names": {
      "part": "general",
      "risk": "low",
      "standard": "Previous legal and trading names, taken from field history after an approved rename; used in matching, never shown as current"
    },
    "vies_status": {
      "part": "general",
      "risk": "high",
      "standard": "valid, not_registered or invalid, with check date and evidence reference (simulated VIES)"
    },
    "supplier_last_activity_at": {
      "part": "supplier",
      "risk": "low",
      "standard": "Last purchase order or invoice date from the ERP"
    },
    "payee_type": {
      "part": "supplier",
      "risk": "high",
      "standard": "own_account, factoring_company or alternative_payee; anything but own_account needs an assignment letter as evidence"
    },
    "contact_status": {
      "part": "contact",
      "risk": "low",
      "standard": "active, left_company, bounced or erased, with the date the contact was last verified"
    }
  },
