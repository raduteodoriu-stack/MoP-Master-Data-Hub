  "kpis": [
    {
      "id": "KPI01",
      "name": "Data Quality Score",
      "numerator": "rule checks passed",
      "denominator": "rule checks applicable, on active golden records",
      "split": [
        "total",
        "dimension",
        "error_only"
      ]
    },
    {
      "id": "KPI02",
      "name": "Completeness",
      "numerator": "mandatory fields filled",
      "denominator": "mandatory fields required for each record's stage"
    },
    {
      "id": "KPI03",
      "name": "Duplicate Rate",
      "numerator": "source records sharing a partner with another record from the same system",
      "denominator": "source records in that system",
      "split": [
        "source_system"
      ]
    },
    {
      "id": "KPI04",
      "name": "Golden Record Coverage",
      "numerator": "source records linked to a partner with no open suggestion",
      "denominator": "all source records"
    },
    {
      "id": "KPI05",
      "name": "Cross-System Consistency",
      "numerator": "governed field values in source systems equal to the golden value",
      "denominator": "governed field values present in source systems"
    },
    {
      "id": "KPI06",
      "name": "Match Review Backlog",
      "measure": "open suggestions at as-of",
      "age": "median working hours open"
    },
    {
      "id": "KPI07",
      "name": "Request Turnaround Time",
      "measure": "median working hours from submitted to closed",
      "split": [
        "request_type",
        "net",
        "gross"
      ]
    },
    {
      "id": "KPI08",
      "name": "Request SLA Attainment",
      "numerator": "requests closed within target (net time)",
      "denominator": "requests closed + requests still open past their target"
    },
    {
      "id": "KPI09",
      "name": "First-Time-Right Rate",
      "numerator": "requests approved without ever being returned",
      "denominator": "requests approved or rejected"
    },
    {
      "id": "KPI10",
      "name": "Verified Bank Details Rate",
      "numerator": "approved suppliers passing T02",
      "denominator": "approved suppliers"
    },
    {
      "id": "KPI11",
      "name": "Match precision and recall",
      "scope": "test data only, against the MDH-004 answer key"
    },
    {
      "id": "KPI12",
      "name": "Tier Override Rate",
      "numerator": "customer roles with a current tier override",
      "denominator": "customer roles with a known calculated tier",
      "split": [
        "effective_tier"
      ]
    }
  ],
  "corporate_events": {
    "rename": "New legal or trading name; the old name is kept as a former name for matching; same tax ID",
    "legal_form_change": "New legal form and name ending; tax ID unchanged (a French SIREN does not change on a legal transformation)",
    "merger_absorption": "The absorbed partner gets block reason absorbed and a successor_of link to the surviving partner; its active roles become inactive; contacts and hierarchy are reviewed by the steward"
  },
