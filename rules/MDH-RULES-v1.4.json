{
  "rules_version": "MDH-RULES-v1.4",
  "description": "MoP Master Data Hub: business partner standards, quality rules, matching, survivorship, requests and KPIs (MDH-002); customer tier (v1.1); same-tax-ID review (v1.2); matching fixes G1-G5 and partner lifecycle, fraud and privacy controls (v1.3); survivorship clarifications G6-G8 (v1.4). Synthetic data only.",
  "changes_from_previous": [
    "G6: 'most recently changed' uses the change time stated by the source (source_updated_at); if the source gives none, the time the hub received the record",
    "G7: a tie between sources changed at the same moment is broken by the fixed order erp, crm, procurement_sheet, support",
    "G8: step 3 never applies to bank details; they come only from the ERP or from a verified, approved change_bank_details request"
  ],
  "calendar": {
    "time_zone": "Europe/Madrid",
    "working_days": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri"
    ],
    "working_hours": {
      "start": "09:00",
      "end": "18:00"
    },
    "public_holidays": "not counted (same as LeadFlow MVP)"
  },
  "identifiers": {
    "business_partner_id": {
      "format": "BP-NNNNNN",
      "regex": "^BP-[0-9]{6}$",
      "reused": false,
      "changes_after_merge": false
    }
  },
  "storage": {
    "keep_value_as_received": true,
    "keep_standardised_value": true,
    "matching_uses": "standardised"
  },
  "severities": {
    "error": "Record not fit for use; a request cannot be approved while it fails",
    "warning": "Reported and queued for the steward; does not block"
  },
  "markets": [
    "ES",
    "PT",
    "FR"
  ],
  "countries": {
    "ES": {
      "tax_id": {
        "name": "NIF (company)",
        "regex": "^[ABCDEFGHJNPQRSUVW][0-9]{7}[0-9A-J]$",
        "check": "es_nif_company_control_character"
      },
      "vat": {
        "prefix": "ES",
        "build": "ES + tax_id"
      },
      "postal_code_regex": "^(0[1-9]|[1-4][0-9]|5[0-2])[0-9]{3}$",
      "iban_length": 24,
      "legal_forms": {
        "S.L.": "Sociedad Limitada",
        "S.L.U.": "Sociedad Limitada Unipersonal",
        "S.A.": "Sociedad Anónima",
        "S.A.U.": "Sociedad Anónima Unipersonal",
        "S.Coop.": "Sociedad Cooperativa"
      }
    },
    "PT": {
      "tax_id": {
        "name": "NIPC",
        "regex": "^[5-9][0-9]{8}$",
        "check": "pt_nipc_mod11"
      },
      "vat": {
        "prefix": "PT",
        "build": "PT + tax_id"
      },
      "postal_code_regex": "^[0-9]{4}-[0-9]{3}$",
      "iban_length": 25,
      "legal_forms": {
        "Lda.": "Sociedade por Quotas",
        "Unipessoal Lda.": "Sociedade Unipessoal por Quotas",
        "S.A.": "Sociedade Anónima"
      }
    },
    "FR": {
      "tax_id": {
        "name": "SIREN",
        "regex": "^[0-9]{9}$",
        "check": "fr_siren_luhn"
      },
      "vat": {
        "prefix": "FR",
        "build": "FR + key + tax_id",
        "key": "(12 + 3 * (SIREN mod 97)) mod 97, two digits"
      },
      "postal_code_regex": "^[0-9]{5}$",
      "iban_length": 27,
      "legal_forms": {
        "SAS": "Société par actions simplifiée",
        "SASU": "Société par actions simplifiée unipersonnelle",
        "SARL": "Société à responsabilité limitée",
        "EURL": "Entreprise unipersonnelle à responsabilité limitée",
        "SA": "Société anonyme"
      }
    }
  },
  "other_countries": "Held with minimal data as a parent company only; not checked against country formats",
  "controlled_values": {
    "payment_terms": [
      "NET15",
      "NET30",
      "NET45",
      "NET60"
    ],
    "supplier_category": [
      "panel_sample_provider",
      "software",
      "professional_services",
      "facilities",
      "other"
