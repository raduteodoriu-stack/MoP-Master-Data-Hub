{
  "rules_version": "MDH-RULES-v1.2",
  "description": "MoP Master Data Hub: business partner standards, quality rules, matching, survivorship, requests, KPIs (MDH-002) and customer tier (v1.1), same-tax-ID review M1B and rule K09 (v1.2). Synthetic data only.",
  "changes_from_previous": [
    "M1 now links automatically only when the standardised names are also at least 0.90 similar",
    "New suggestion rule M1B: same valid tax ID but different names, sent to the steward with high priority (same legal entity, or a subsidiary carrying another company's tax ID)",
    "New warning rule K09: a source record carries a tax ID that belongs to another partner"
  ],
  "calendar": {
    "time_zone": "Europe/Madrid",
    "working_days": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri"
    ],
    "working_hours": {
      "start": "09:00",
      "end": "18:00"
    },
    "public_holidays": "not counted (same as LeadFlow MVP)"
  },
  "identifiers": {
    "business_partner_id": {
      "format": "BP-NNNNNN",
      "regex": "^BP-[0-9]{6}$",
      "reused": false,
      "changes_after_merge": false
    }
  },
  "storage": {
    "keep_value_as_received": true,
    "keep_standardised_value": true,
    "matching_uses": "standardised"
  },
  "severities": {
    "error": "Record not fit for use; a request cannot be approved while it fails",
    "warning": "Reported and queued for the steward; does not block"
  },
  "markets": [
    "ES",
    "PT",
    "FR"
  ],
  "countries": {
    "ES": {
      "tax_id": {
        "name": "NIF (company)",
        "regex": "^[ABCDEFGHJNPQRSUVW][0-9]{7}[0-9A-J]$",
        "check": "es_nif_company_control_character"
      },
      "vat": {
        "prefix": "ES",
        "build": "ES + tax_id"
      },
      "postal_code_regex": "^(0[1-9]|[1-4][0-9]|5[0-2])[0-9]{3}$",
      "iban_length": 24,
      "legal_forms": {
        "S.L.": "Sociedad Limitada",
        "S.L.U.": "Sociedad Limitada Unipersonal",
        "S.A.": "Sociedad Anónima",
        "S.A.U.": "Sociedad Anónima Unipersonal",
        "S.Coop.": "Sociedad Cooperativa"
      }
    },
    "PT": {
      "tax_id": {
        "name": "NIPC",
        "regex": "^[5-9][0-9]{8}$",
        "check": "pt_nipc_mod11"
      },
      "vat": {
        "prefix": "PT",
        "build": "PT + tax_id"
      },
      "postal_code_regex": "^[0-9]{4}-[0-9]{3}$",
      "iban_length": 25,
      "legal_forms": {
        "Lda.": "Sociedade por Quotas",
        "Unipessoal Lda.": "Sociedade Unipessoal por Quotas",
        "S.A.": "Sociedade Anónima"
      }
    },
    "FR": {
      "tax_id": {
        "name": "SIREN",
        "regex": "^[0-9]{9}$",
        "check": "fr_siren_luhn"
      },
      "vat": {
        "prefix": "FR",
        "build": "FR + key + tax_id",
        "key": "(12 + 3 * (SIREN mod 97)) mod 97, two digits"
      },
      "postal_code_regex": "^[0-9]{5}$",
      "iban_length": 27,
      "legal_forms": {
        "SAS": "Société par actions simplifiée",
        "SASU": "Société par actions simplifiée unipersonnelle",
        "SARL": "Société à responsabilité limitée",
        "EURL": "Entreprise unipersonnelle à responsabilité limitée",
        "SA": "Société anonyme"
      }
    }
  },
  "other_countries": "Held with minimal data as a parent company only; not checked against country formats",
  "controlled_values": {
    "payment_terms": [
      "NET15",
      "NET30",
      "NET45",
      "NET60"
    ],
    "supplier_category": [
      "panel_sample_provider",
      "software",
      "professional_services",
      "facilities",
      "other"
    ],
    "industry_code": [
      "market_research",
      "polling",
      "research_consultancy",
      "panel_sample_provider",
      "research_technology",
      "advertising_media_pr_agency",
      "ux_research_agency",
      "management_consultancy",
      "consumer_goods",
      "retail_ecommerce",
      "technology_telecoms",
      "financial_services",
      "automotive_mobility",
      "healthcare_pharma",
      "travel_hospitality",
      "media_entertainment_gaming",
      "energy_utilities",
      "public_academic_nonprofit",
      "other",
      "unknown"
    ],
    "employee_band": [
      "1-10",
      "11-49",
      "50-249",
      "250-999",
      "1000_plus",
      "unknown"
    ],
    "contact_legal_basis": [
      "contract",
      "legitimate_interest",
      "consent"
    ],
    "block_reason": [
      "duplicate",
      "credit",
      "payment",
      "compliance"
    ],
    "relationship_type": [
      "subsidiary_of"
    ],
    "free_email_domains": [
      "gmail.com",
      "googlemail.com",
      "hotmail.com",
      "hotmail.es",
      "hotmail.fr",
      "outlook.com",
      "outlook.es",
      "live.com",
      "yahoo.com",
      "yahoo.es",
      "yahoo.fr",
      "icloud.com",
      "proton.me",
      "protonmail.com",
      "sapo.pt",
      "orange.fr",
      "free.fr",
      "laposte.net",
      "gmx.com"
    ],
    "name_placeholders": [
      "test",
      "n/a",
      "na",
      "tbc",
      "tbd",
      "unknown",
      "xxx",
      "-",
      "none",
      "dummy"
    ]
  },
  "sources": {
    "crm": "HubSpot CRM (LeadFlow companies)",
    "erp": "Finance/ERP: customer and supplier accounts",
    "support": "Support desk",
    "procurement_sheet": "Procurement spreadsheet of suppliers"
  },
  "field_groups": {
    "legal_identity": {
      "fields": [
        "legal_name",
        "legal_form",
        "country",
        "tax_id",
        "vat_number"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "addresses": {
      "fields": [
        "registered_address",
        "billing_address"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "customer_payment": {
      "fields": [
        "payment_terms_customer",
        "bill_to_partner",
        "invoice_email",
        "billing_block"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "customer_commercial": {
      "fields": [
        "trading_name",
        "web_domain",
        "industry_code",
        "employee_band",
        "customer_tier_override",
        "account_owner"
      ],
      "owner": "sales_director",
      "winning_source": "crm"
    },
    "supplier_payment": {
      "fields": [
        "bank_details",
        "payment_terms_supplier",
        "remittance_email",
        "payment_block"
      ],
      "owner": "finance_controller",
      "winning_source": "erp"
    },
    "supplier_commercial": {
      "fields": [
        "supplier_category",
        "internal_contact"
      ],
      "owner": "head_of_operations",
      "winning_source": "procurement_sheet",
      "winning_source_after_migration": "hub"
    },
    "relationships": {
      "fields": [
        "parent_partner"
      ],
      "owner": "sales_director",
      "winning_source": "hub"
    },
    "lifecycle": {
      "fields": [
        "customer_stage",
        "supplier_stage",
        "block"
      ],
      "owner": {
        "customer": "sales_director",
        "supplier": "head_of_operations",
        "block": "finance_controller"
      },
      "winning_source": "hub"
    },
    "contact_persons": {
      "fields": [
        "first_name",
        "last_name",
        "work_email",
        "role",
        "legal_basis"
      ],
      "owner": {
        "customer": "sales_director",
        "supplier": "head_of_operations"
      },
      "consulted": "dpo",
      "winning_source": "crm"
    }
  },
  "fields": {
    "legal_name": {
      "part": "general",
      "risk": "high",
      "standard": "As on the tax registration, legal form in the country's standard spelling; no placeholders"
    },
    "trading_name": {
      "part": "general",
      "risk": "low",
      "standard": "Name the company is known by; used for prospects before the legal name is known"
    },
    "legal_form": {
      "part": "general",
      "risk": "high",
      "standard": "From countries.<cc>.legal_forms"
    },
    "country": {
      "part": "general",
      "risk": "high",
      "standard": "ISO 3166-1 alpha-2"
    },
    "tax_id": {
      "part": "general",
      "risk": "high",
      "standard": "Country format and check digit; stored without spaces, dots or dashes"
    },
    "vat_number": {
      "part": "general",
      "risk": "high",
      "standard": "Derived from tax_id and country; never typed by hand"
    },
    "web_domain": {
      "part": "general",
      "risk": "low",
      "standard": "Lower case, registrable domain only (no www, scheme or path); not a free email domain"
    },
    "registered_address": {
      "part": "general",
      "risk": "high",
      "standard": "Street, postal code, city, region, country as separate fields"
    },
    "phone": {
      "part": "general",
      "risk": "low",
      "standard": "International format: + and digits only"
    },
    "account_owner": {
      "part": "customer",
      "risk": "low",
      "standard": "An existing, active LeadFlow owner ID"
    },
    "industry_code": {
      "part": "customer",
      "risk": "low",
      "standard": "controlled_values.industry_code"
    },
    "employee_band": {
      "part": "customer",
      "risk": "low",
      "standard": "controlled_values.employee_band"
    },
    "billing_address": {
      "part": "customer",
      "risk": "high",
      "standard": "Same structure as registered_address"
    },
    "bill_to_partner": {
      "part": "customer",
      "risk": "high",
      "standard": "An existing, active, unblocked partner"
    },
    "payment_terms_customer": {
      "part": "customer",
      "risk": "high",
      "standard": "controlled_values.payment_terms; anything else needs the Finance Controller"
    },
    "invoice_email": {
      "part": "customer",
      "risk": "high",
      "standard": "Valid format; shared mailbox preferred"
    },
    "billing_block": {
      "part": "customer",
      "risk": "high",
      "standard": "Reason and approver when set"
    },
    "supplier_category": {
      "part": "supplier",
      "risk": "low",
      "standard": "controlled_values.supplier_category"
    },
    "internal_contact": {
      "part": "supplier",
      "risk": "low",
      "standard": "MoP Cloud employee responsible for the supplier"
    },
    "payment_terms_supplier": {
      "part": "supplier",
      "risk": "high",
      "standard": "controlled_values.payment_terms"
    },
    "remittance_email": {
      "part": "supplier",
      "risk": "high",
      "standard": "Valid format; shared mailbox preferred"
    },
    "bank_details": {
      "part": "supplier",
      "risk": "high",
      "standard": "IBAN with valid length and check digits, account holder name, last verification date, method and verifier"
    },
    "payment_block": {
      "part": "supplier",
      "risk": "high",
      "standard": "Reason and approver when set"
    },
    "contact_person": {
      "part": "contact",
      "risk": "personal_data",
      "standard": "First name, last name, work email, role, legal basis; no private email, no other personal data"
    },
    "parent_partner": {
      "part": "relationship",
      "risk": "high",
      "standard": "Existing, unblocked partner; no loops; at most five levels"
    },
    "customer_tier_override": {
      "part": "customer",
      "risk": "low",
      "standard": "tier_1, tier_2 or tier_3; set only through an approved override_customer_tier request"
    }
  },
  "lifecycle": {
    "customer": [
      "prospect",
      "customer",
      "inactive",
      "blocked"
    ],
    "supplier": [
      "requested",
      "approved",
      "inactive",
      "blocked"
    ]
  },
